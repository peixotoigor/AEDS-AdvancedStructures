{
  "version": "2.0",
  "permissionMode": "review-driven",
  "thinkingLevel": "high",
  "executionPolicy": {
    "allowList": [
      "g++",
      "clang++",
      "cmake",
      "ctest",
      "pdflatex",
      "make",
      "wsl",
      "git status",
      "git diff"
    ],
    "denyList": [
      "rm -rf /",
      "git push --force"
    ],
    "requireReview": [
      "git push"
    ]
  },
  "sandbox": {
    "networkIsolation": false,
    "filesystemScope": "workspace_only"
  }
}